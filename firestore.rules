rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'rafatsaeed719@gmail.com'; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().get('disabled', false) != true; }
    function mine(d) { return active() && d.get('phone', '') != '' && d.phone == me().phone; }

    match /users/{u} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == u);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == u && request.resource.data.role == 'customer' && request.resource.data.phone is string && request.auth.token.email == request.resource.data.phone + '@kolak-gamila.app' && request.resource.data.get('disabled', false) == false);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == u && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone', 'role', 'disabled', 'password', 'createdByAdmin']));
      allow delete: if isAdmin();
    }
    match /customers/{id} { allow read: if isAdmin() || mine(resource.data); allow write: if isAdmin(); }
    match /entries/{id} { allow read: if isAdmin() || mine(resource.data); allow write: if isAdmin(); }
    match /products/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /offers/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /productCosts/{id} { allow read, write: if isAdmin(); }
    match /meta/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /orders/{id} {
      allow read: if isAdmin() || (active() && resource.data.uid == request.auth.uid);
      allow create: if active() && request.resource.data.uid == request.auth.uid && request.resource.data.phone == me().phone && request.resource.data.status == 'new';
      allow update: if isAdmin() || (active() && resource.data.uid == request.auth.uid && resource.data.status == 'new' && request.resource.data.status == 'cancelled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }
  }
}
